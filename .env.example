# ==============================================================================
# TRACE — Environment Configuration
# Copy to .env and fill in. NEVER commit .env.
# ==============================================================================

# Delhi Open Transit Data Portal
OTD_API_KEY=your_otd_api_key_here
OTD_VEHICLE_POSITIONS_URL=https://otd.delhi.gov.in/api/realtime/VehiclePositions.pb

# Collector settings (adjust after two_poll_test.py result)
POLL_INTERVAL_SECONDS=60
SERVICE_START_HOUR=5
SERVICE_END_HOUR=23

# PostgreSQL (Docker container defaults match docker-compose.yml)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=trace_db
PG_USER=postgres
PG_PASSWORD=trace_pass

# Static GTFS (unzipped folder)
STATIC_GTFS_PATH=data/static_gtfs

# Weather (Open-Meteo needs no key — leave blank)
OPENWEATHER_API_KEY=
WEATHER_LAT=28.6139
WEATHER_LON=77.2090
